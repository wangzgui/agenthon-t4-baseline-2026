FROM python:3.13-slim
LABEL qfbench2.interface_version="2.0"
WORKDIR /app
COPY agent_s15.py /app/agent_s15.py
COPY s15_semantics.py /app/s15_semantics.py
COPY s15_numerics.py /app/s15_numerics.py
COPY s15_fundamentals.py /app/s15_fundamentals.py
COPY s15_calibration.py /app/s15_calibration.py
ENTRYPOINT ["python", "/app/agent_s15.py"]
